# Copy to .env and change what you need.
DATABASE_URL=postgresql+psycopg://egyptora:egyptora@localhost:5433/egyptora
# READONLY_DATABASE_URL=postgresql+psycopg://egyptora_readonly:readonly@localhost:5433/egyptora
JWT_SECRET=dev-only-secret-change-me-in-.env-0123456789
AI_MOCK=true
EXPOSE_AI_ROUTES=true
# Language model (OpenRouter or any OpenAI-compatible API). Never commit a real key.
USE_LLM=false
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
